# Copy to .env for local use. Never commit .env or real passwords.
APP_NAME=QueryMate AI
APP_ENV=development
LOG_LEVEL=INFO

# Local Ollama models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.0
OLLAMA_TIMEOUT_SECONDS=120

# MySQL demo database; use the password configured in company_db_readonly_user.sql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=company_db
MYSQL_USER=querymate_readonly
MYSQL_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
MYSQL_CONNECT_TIMEOUT=10
SQL_MAX_ROWS=500
SQL_QUERY_TIMEOUT_SECONDS=15

# Local files and vector store
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma_db
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RELEVANCE_SCORE=0.15

# Agent workflow bounds
GRAPH_RECURSION_LIMIT=12
AGENT_MAX_RETRIES=1

# Local MCP stdio server
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=mcp_server/server.py
